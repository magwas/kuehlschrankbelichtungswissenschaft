(module Luminus_CXM-22-HM-61-54-AC30-P1-3
  (layer F.Cu)
  (tedit 5F7F1A95)
  (descr "COB LED, 28mm x 28mm, 22mm LES, Luminus CXM-22-HM-61-54-AC30-P1-3")
  (tags "LED COB")
  (attr smd)
  
  # Courtyard - slightly larger than footprint
  (fp_rect (start -14.5 -14.5) (end 14.5 14.5) (layer F.CrtYd) (width 0.05))
  
  # Silk screen outline
  (fp_rect (start -14 -14) (end 14 14) (layer F.SilkS) (width 0.12))
  
  # Fabrication outline
  (fp_rect (start -14 -14) (end 14 14) (layer F.Fab) (width 0.1))
  
  # Light Emitting Surface (LES) - 22mm diameter circle
  (fp_circle (center 0 0) (end 11 0) (layer F.Fab) (width 0.1))
  (fp_circle (center 0 0) (end 11 0) (layer F.SilkS) (width 0.12))
  
  # Polarity marker (cathode indicator)
  (fp_line (start 10 -2) (end 12 -2) (layer F.SilkS) (width 0.12))
  (fp_line (start 11 -1) (end 11 -3) (layer F.SilkS) (width 0.12))
  
  # SMD PADS - Based on typical COB LED construction
  
  # Anode (+) pad - positioned at bottom edge
  (pad "1" smd rect (at 0 -12.5) (size 3 2) (layers F.Cu F.Paste F.Mask))
  
  # Cathode (-) pad - positioned at top edge  
  (pad "2" smd rect (at 0 12.5) (size 3 2) (layers F.Cu F.Paste F.Mask))
  
  # Large thermal pad in center (exposed die attach area)
  (pad "" smd rect (at 0 0) (size 20 20) (layers F.Cu F.Paste F.Mask))
  
  # Additional thermal vias (optional - for better heat dissipation)
   (pad "" thru_hole circle (at -5 -5) (size 1 1) (drill 0.6) (layers *.Cu *.Mask) (zone_connect 2))
   (pad "" thru_hole circle (at 5 -5) (size 1 1) (drill 0.6) (layers *.Cu *.Mask) (zone_connect 2))
   (pad "" thru_hole circle (at -5 5) (size 1 1) (drill 0.6) (layers *.Cu *.Mask) (zone_connect 2))
   (pad "" thru_hole circle (at 5 5) (size 1 1) (drill 0.6) (layers *.Cu *.Mask) (zone_connect 2))
  
  # Fabrication layer text
  (fp_text value "Luminus_CXM-22-HM-61-54-AC30-P1-3" (at 0 -16) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text reference "D**" (at 0 16) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15))))
)

